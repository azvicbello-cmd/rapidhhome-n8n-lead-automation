                    "rightValue": "cold",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "id": "cold-rule"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "COLD"
            }
          ]
        },
        "options": {}
      },
