      "name": "Webhook"
    },
    {
      "parameters": {
        "jsCode": "const lead = $json.body ?? $json;\n\nconst name = String(lead.name ?? '').trim();\nconst email = String(lead.email ?? '').trim().toLowerCase();\nconst phone = String(lead.phone ?? '').trim();\nconst service = String(lead.service ?? '').trim();\nconst description = String(lead.description ?? '').trim();\nconst preferredDate = String(lead.preferred_date ?? '').trim();\n\nconst text = `${service} ${description}`.toLowerCase();\n\nlet score = 0;\n\nconst hotWords = [\n  'urgent',\n  'today',\n  'emergency',\n  'stopped',\n  'not working',\n  'no cooling',\n  'no heat',\n  'leak',\n  'flood',\n  'immediately'\n];\n\nfor (const word of hotWords) {\n  if (text.includes(word)) score += 15;\n}\n\nif (name) score += 5;\nif (email) score += 5;\nif (phone) score += 10;\nif (preferredDate) score += 10;\n\nlet qualification = 'cold';\nlet urgency = 'low';\n\nif (score >= 50) {\n  qualification = 'hot';\n  urgency = 'high';\n} else if (score >= 25) {\n  qualification = 'warm';\n  urgency = 'normal';\n}\n\nreturn [\n  {\n    json: {\n      name,\n      email,\n      phone,\n      service,\n      description,\n      preferred_date: preferredDate,\n      lead_score: score,\n      qualification,\n      urgency,\n      received_at: new Date().toISOString()\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "c64274a6-4979-416a-adff-8dfc858b5fa1",
      "name": "Normalize & Score Lead"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                },
                "conditions": [
                  {
                    "leftValue": "={{$json.qualification}}",
                    "rightValue": "hot",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "id": "hot-rule"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "HOT"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                },
                "conditions": [
                  {
                    "leftValue": "={{$json.qualification}}",
                    "rightValue": "warm",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "id": "warm-rule"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "WARM"
            },
            {
