{"name":"RapidHome Lead Automation – Public Demo (Advanced)","nodes":[{"parameters":{"httpMethod":"POST","path":"rapidhhome-lead","authentication":"headerAuth","responseMode":"responseNode","options":{"rawBody":true}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[0,0],"id":"cce33a4f-dad2-4752-aefb-b5ed78d421e5","name":"Webhook"},{"parameters":{"jsCode":"const lead = $json.body ?? $json;\n\nconst name = String(lead.name ?? '').trim();\nconst email = String(lead.email ?? '').trim().toLowerCase();\nconst phone = String(lead.phone ?? '').trim();\nconst service = String(lead.service ?? '').trim();\nconst description = String(lead.description ?? '').trim();\nconst preferredDate = String(lead.preferred_date ?? '').trim();\n\n// ---------- Stable idempotency key ----------\n\nconst normalizeKeyPart = (value) =>\n  String(value ?? '')\n    .trim()\n    .toLowerCase()\n    .replace(/\\s+/g, ' ');\n\nconst phoneKey = phone.replace(/\\D/g, '');\n\nconst externalId = normalizeKeyPart(\n  lead.lead_id ?? lead.id ?? ''\n);\n\nlet leadKey;\n\nif (externalId) {\n  // Best case: the source system already gives us a unique ID\n  leadKey = `external:${externalId}`;\n} else {\n  // Otherwise build a deterministic identity from normalized lead fields\n  leadKey = [\n    email,\n    phoneKey,\n    normalizeKeyPart(name),\n    normalizeKeyPart(service),\n    preferredDate\n  ].join('|');\n\n  leadKey = `lead:${leadKey}`;\n}\n\n// ---------- Existing scoring logic ----------\n\nconst text = `${service} ${description}`.toLowerCase();\n\nlet score = 0;\n\nconst hotWords = [\n  'urgent',\n  'today',\n  'emergency',\n  'stopped',\n  'not working',\n  'no cooling',\n  'no heat',\n  'leak',\n  'flood',\n  'immediately'\n];\n\nfor (const word of hotWords) {\n  if (text.includes(word)) score += 15;\n}\n\nif (name) score += 5;\nif (email) score += 5;\nif (phone) score += 10;\nif (preferredDate) score += 10;\n\nlet qualification = 'cold';\nlet urgency = 'low';\n\nif (score >= 50) {\n  qualification = 'hot';\n  urgency = 'high';\n} else if (score >= 25) {\n  qualification = 'warm';\n  urgency = 'normal';\n}\n\nreturn [\n  {\n    json: {\n      lead_key: leadKey,\n      name,\n      email,\n      phone,\n      service,\n      description,\n      preferred_date: preferredDate,\n      lead_score: score,\n      qualification,\n      urgency,\n      received_at: new Date().toISOString()\n    }\n  }\n];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[672,0],"id":"470e78bf-3bd5-4423-8deb-4df0dd60c2ed","name":"Normalize & Score Lead"},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"leftValue":"={{$json.qualification}}","rightValue":"hot","operator":{"type":"string","operation":"equals"},"id":"206ce114-2452-4d9b-b990-01b0d8042aa2"}],"combinator":"and"},"renameOutput":true,"outputKey":"HOT"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"e870fb0c-67a8-4dd9-8127-35a1b804be2f","leftValue":"={{$json.qualification}}","rightValue":"warm","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"WARM"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"5f52b05c-735f-4b18-bbc0-819d24908259","leftValue":"={{$json.qualification}}","rightValue":"cold","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"COLD"}]},"options":{}},"type":"n8n-nodes-base.switch","typeVersion":3.4,"position":[1120,0],"id":"8bc6955a-6ee6-4b37-bb0d-ac9374c2c177","name":"Route by Qualification"},{"parameters":{"assignments":{"assignments":[{"id":"d163c0ee-c44e-4c9b-9b42-da030fb24933","name":"alert_type","value":"HOT_LEAD","type":"string"},{"id":"5c3494c2-32d0-4ed8-b2b5-1f7b7b0b